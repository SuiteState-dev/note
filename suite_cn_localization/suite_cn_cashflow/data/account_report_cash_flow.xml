<?xml version="1.0" encoding="utf-8"?>
<!--
    现金流量表（直接法，小企业会计准则 ASSBE）。单套交付。解耦：不依赖 chart template。
    行次按客户实报法定格式（万佳设计集团 2026-06），双列：本月(balance,左)/本年累计(ytd,右)；
      行21期初两列 date_scope 不同：本月=to_beginning_of_period，本年累计=to_beginning_of_fiscalyear。
    符号：分类/未分类 -sum 翻正；期初 sum。分类行 domain 已排除现金行本身（R11-T1/P2）。
    行序：sequence 采 ×10 间隔，标题（一/二/三段）与未分类行内嵌于对应位置（R11-T5）。
    ASBE 草稿已移出交付范围至 data/draft/，manifest 不加载。

    现金判据（R13-A1，路线甲落地时一次机械替换用）：
      现金判据 = ('account_id.account_type','=','asset_cash')
      路线甲落地时整体替换为 ('account_id.cn_is_cash','=',True)，见 §7.2 A2-口径。
      出现位置：分类行排除×16行(bal/ytd 共32)、UNC 行×2、行21×2。
    「本 move 触及现金」判据（P9，R13-A1）= ('move_id.line_ids.account_id.account_type','=','asset_cash')
      分类行与未分类行同用此 move 级条件：只有触及现金的凭证才计入现金流量表。
      未触及现金的打标行（如付款走 Outstanding 未到银行）在对账前不进表——正确（钱未到银行）。
      路线甲落地时 move 级条件同步替换为 ('move_id.line_ids.account_id.cn_is_cash','=',True)。
-->
<odoo>
    <record id="cn_cash_flow_s" model="account.report">
        <field name="name">现金流量表（小企业会计准则）</field>
        <field name="country_id" ref="base.cn"/>
        <field name="availability_condition">country</field>
        <!--
          R23-T1: attach as a country (CN) variant of the official Cash Flow
          Statement so it is reachable from Accounting → Reporting → Cash Flow
          Statement without a bespoke menu. A CN company opening that menu is
          auto-switched to this variant (country match); the variant dropdown
          still offers the official report. Verified R23: the variant renders
          via THIS report's own line_ids (domain engine) — it carries no
          custom_handler_model_name, so the official custom handler does not
          touch our取数; the 22 lines / two columns are identical to the
          stand-alone render. Mirrors the official l10n_cn ASBE BS/PL variants.
        -->
        <field name="root_report_id" ref="account_reports.cash_flow_report"/>
        <field name="filter_multi_company">selector</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="column_ids">
            <record id="cn_cf_s_col_m" model="account.report.column">
                <field name="name">本月金额</field><field name="expression_label">balance</field>
                <field name="figure_type">monetary</field><field name="sequence">1</field>
            </record>
            <record id="cn_cf_s_col_y" model="account.report.column">
                <field name="name">本年累计金额</field><field name="expression_label">ytd</field>
                <field name="figure_type">monetary</field><field name="sequence">2</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="cn_cf_s_t1" model="account.report.line">
                <field name="name">一、经营活动产生的现金流量：</field><field name="sequence">5</field>
            </record>
            <record id="cn_cf_s_1" model="account.report.line">
                <field name="name">1 销售产成品、商品、提供劳务收到的现金</field><field name="code">CN_CF_S_1</field><field name="sequence">10</field>
                <field name="expression_ids">
                    <record id="cn_cf_s_1_bal" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula">['&amp;', '&amp;', ('cn_cash_flow_item_id.code', '=', 'S1'), ('account_id.account_type', '!=', 'asset_cash'), ('move_id.line_ids.account_id.account_type', '=', 'asset_cash')]</field>
                        <field name="subformula">-sum</field>
                    </record>
                    <record id="cn_cf_s_1_ytd" model="account.report.expression">
                        <field name="label">ytd</field>
                        <field name="engine">domain</field>
                        <field name="formula">['&amp;', '&amp;', ('cn_cash_flow_item_id.code', '=', 'S1'), ('account_id.account_type', '!=', 'asset_cash'), ('move_id.line_ids.account_id.account_type', '=', 'asset_cash')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">from_fiscalyear</field>
                    </record>
                </field>
            </record>
            <record id="cn_cf_s_2" model="account.report.line">
                <field name="name">2 收到其他与经营活动有关的现金</field><field name="code">CN_CF_S_2</field><field name="sequence">20</field>
