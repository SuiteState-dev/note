<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 科目表：默认现金流量项目 -->
    <record id="view_account_form_cn_cashflow" model="ir.ui.view">
        <field name="name">account.account.form.cn.cashflow</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <!-- R22-T1: direction-split defaults. A single-direction account
                     takes the same item on both fields; a double-direction one
                     (e.g. 预付账款) takes a different item per side. -->
                <field name="cn_default_cash_flow_item_debit_id"/>
                <field name="cn_default_cash_flow_item_credit_id"/>
            </field>
        </field>
    </record>

    <!-- 会计凭证行：现金流量项目（可选列） -->
    <record id="view_move_line_tree_cn_cashflow" model="ir.ui.view">
        <field name="name">account.move.line.list.cn.cashflow</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="cn_cash_flow_item_id" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- 设置：现金笔必填开关 -->
    <record id="res_config_settings_view_form_cn_cashflow" model="ir.ui.view">
        <field name="name">res.config.settings.form.cn.cashflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="after">
                <block title="China Cash Flow" id="cn_cashflow_settings">
                    <setting id="cn_cashflow_item_required_setting"
                             string="Require Cash Flow Item"
                             help="Posting an entry that touches a cash/bank account requires a Cash Flow Item on every counterpart line.">
                        <field name="cn_cashflow_item_required"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
