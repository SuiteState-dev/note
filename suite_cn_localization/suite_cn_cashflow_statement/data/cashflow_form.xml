<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

  <!-- ======= 现金流量表 月季报 (bridge: CF x statement) ======= -->
  <record id="cn_form_cf" model="suite.cn.statement.form">
    <field name="report_id" ref="suite_cn_cashflow.cn_cash_flow_s"/>
    <field name="title">现金流量表</field>
    <field name="title_suffix">（适用执行小企业会计准则的企业）</field>
    <field name="form_no">会小企03表</field>
    <field name="sheet_name">现金流量表_月季报</field>
    <field name="layout">single</field>
    <field name="period_mode">range</field>
    <field name="period_scope">monthly_quarterly</field>
    <field name="standard_version">na</field>
  </record>
  <!-- R27: 官方月季报现金流量表列头=「本期金额」(季报时本期=本季，非本月)。
       逐格对位 tests/fixtures 月季报.xls (4,3)。列序(本期左|累计右)本已正确。 -->
  <record id="cn_col_cf_1" model="suite.cn.statement.column">
    <field name="form_id" ref="cn_form_cf"/><field name="sequence">10</field>
    <field name="header">本期金额</field><field name="expression_label">balance</field>
  </record>
  <record id="cn_col_cf_2" model="suite.cn.statement.column">
    <field name="form_id" ref="cn_form_cf"/><field name="sequence">20</field>
    <field name="header">本年累计金额</field><field name="expression_label">ytd</field>
  </record>

  <!-- ======= 现金流量表 年报 (R26-T2): 本年累计金额 | 上年金额.
       行借用月季报 cn_form_cf (rows_from_id). ======= -->
  <record id="cn_form_cf_annual" model="suite.cn.statement.form">
    <field name="report_id" ref="suite_cn_cashflow.cn_cash_flow_s"/>
    <field name="title">现金流量表</field>
    <field name="title_suffix">（适用执行小企业会计准则的企业）</field>
    <field name="form_no">会小企03表</field>
    <field name="sheet_name">现金流量表_年</field>
    <field name="layout">single</field>
    <field name="period_mode">range</field>
    <field name="period_scope">annual</field>
    <field name="standard_version">na</field>
    <field name="rows_from_id" ref="cn_form_cf"/>
  </record>
  <record id="cn_col_cf_annual_1" model="suite.cn.statement.column">
    <field name="form_id" ref="cn_form_cf_annual"/><field name="sequence">10</field>
    <field name="header">本年累计金额</field><field name="expression_label">ytd</field>
    <field name="column_group">primary</field>
  </record>
  <record id="cn_col_cf_annual_2" model="suite.cn.statement.column">
    <field name="form_id" ref="cn_form_cf_annual"/><field name="sequence">20</field>
    <field name="header">上年金额</field><field name="expression_label">balance</field>
    <field name="column_group">comparison</field>
  </record>

  <record id="cn_row_cf_10" model="suite.cn.statement.row">
    <field name="form_id" ref="cn_form_cf"/><field name="sequence">10</field>
    <field name="row_no"></field><field name="name">一、经营活动产生的现金流量：</field>
    <field name="is_header" eval="True"/>
  </record>
  <record id="cn_row_cf_20" model="suite.cn.statement.row">
    <field name="form_id" ref="cn_form_cf"/><field name="sequence">20</field>
    <field name="row_no">1</field><field name="name">销售产成品、商品、提供劳务收到的现金</field>
    <field name="report_line_id" ref="suite_cn_cashflow.cn_cf_s_1"/>
  </record>
  <record id="cn_row_cf_30" model="suite.cn.statement.row">
    <field name="form_id" ref="cn_form_cf"/><field name="sequence">30</field>
