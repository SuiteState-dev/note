<odoo noupdate="0">

  <!-- ================= ASBE 资产负债表 (已执行新三准则, two-column) ================= -->
  <!-- 附录A 逐字转录。列=期末余额/上年年末余额 (同为 primary group)。 -->
  <!-- 官方有·报送无 3 行不绑定：买入返售金融资产 cn_faur + 当年/以前年度未分配 2 子行。 -->
  <!-- 🔴 R26-T2: 手上的 ASBE 是【季报版】(税局入口截图停 2026-Q2)。ASBE 年报版列口径
       无官方材料 → period_scope='monthly_quarterly'，绝不能留 'any'。选年报时向导显式报
       「该准则的年报版式尚未支持」而非回退季报(会造成错口径)。standard_version='executed'
       (已执行版)——把准则版本维度建全，未执行版解冻时零迁移。 -->
  <record id="cn_form_asbe_bs" model="suite.cn.statement.form">
    <field name="report_id" ref="l10n_cn_reports.l10n_cn_asbe_bs"/>
    <field name="title">资产负债表</field>
    <field name="title_suffix">（适用执行企业会计准则的企业）</field>
    <field name="form_no">会企01表</field>
    <field name="sheet_name">资产负债表</field>
    <field name="layout">two_column</field>
    <field name="period_mode">point</field>
    <field name="has_row_no" eval="True"/>
    <field name="period_scope">monthly_quarterly</field>
    <field name="standard_version">executed</field>
    <!-- R44-T2: 前缀直取 8 项取数口径披露(中式版式导出页脚,中性格式)。文案与
         report_columns_asbe.xml 的 cn_asbe_bs_prefix_disclosure(account.report.line)
         【一字一致】——两条载体覆盖两条渲染路径(通用 _get_lines / 中式版式 form)。
         R45-T2:删末句「…将显示为 0」数值预测(148/1504 撞码会显示错的非零数而非 0),
         改为「请核对上述项目的取数范围」;两载体同步同改(惯例29:漏一条即一份导出带旧文案)。 -->
    <field name="footer_note">附注·取数口径：下列项目按科目编码前缀直接取数——交易性金融资产（1101）、合同资产（148）、债权投资（1504）、其他债权投资（1505）、其他权益工具投资（1513）、合同负债（2204）、持有待售负债（2245）、租赁负债（251）。贵司若采用其他编码体系，请核对上述项目的取数范围。</field>
  </record>
