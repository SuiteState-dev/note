<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cn_statement_export_form" model="ir.ui.view">
        <field name="name">suite.cn.statement.export.form</field>
        <field name="model">suite.cn.statement.export</field>
        <field name="arch" type="xml">
            <form string="中式版式导出">
                <group>
                    <field name="report_id" invisible="1"/>
                    <field name="options_json" invisible="1"/>
                    <field name="period_scope" widget="radio"/>
                </group>
                <p class="text-muted">
                    与税局「报送期间」单选同构。默认月季报（一年四次）；年报每年一次。
                </p>
                <footer>
                    <button name="action_export" type="object" string="导出"
                            class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
